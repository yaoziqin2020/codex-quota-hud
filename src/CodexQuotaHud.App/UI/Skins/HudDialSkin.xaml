<skins:AnimatedQuotaSkin x:Class="CodexQuotaHud.App.UI.Skins.HudDialSkin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexQuotaHud.App.UI.Controls"
        xmlns:skins="clr-namespace:CodexQuotaHud.App.UI.Skins"
        Width="132" Height="132" Background="Transparent">
    <Grid Margin="3">
        <Ellipse Margin="4" Fill="#F008111B" Stroke="#854DDDF9" StrokeThickness="1.2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#2DDFFF" BlurRadius="13" ShadowDepth="0" Opacity=".34" />
            </Ellipse.Effect>
        </Ellipse>
        <Grid RenderTransformOrigin=".5,.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="OuterDialTransform" />
            </Grid.RenderTransform>
            <Ellipse Margin="7" Stroke="#9E50DFF8" StrokeThickness="2"
                     StrokeDashArray=".5,4.2" />
            <Path Data="M 66,7 L 66,16 M 66,116 L 66,125 M 7,66 L 16,66 M 116,66 L 125,66"
                  Stroke="#D96AF3FF" StrokeThickness="2" />
            <Path Data="M 26,22 L 31,28 M 101,104 L 106,110 M 22,106 L 28,101 M 104,31 L 110,26"
                  Stroke="#6B8D78FF" StrokeThickness="1.4" />
        </Grid>
        <Grid RenderTransformOrigin=".5,.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="InnerDialTransform" />
            </Grid.RenderTransform>
            <Ellipse Margin="25" Stroke="#686D7BFF" StrokeThickness="1.2"
                     StrokeDashArray="1,5" />
            <Border Width="2" Height="44" Background="#4F77ECFF"
                    VerticalAlignment="Top" Margin="0,18,0,0" />
        </Grid>
        <controls:ProgressArc x:Name="SecondaryArc" Margin="12"
                              Stroke="#C58368FF" TrackStroke="#263F356D"
                              StrokeThickness="3.5" />
        <controls:ProgressArc x:Name="PrimaryArc" Margin="21"
                              Stroke="#F14DE5FA" TrackStroke="#2B4CD4E8"
                              StrokeThickness="5" />
        <Ellipse Margin="34" Fill="#E20D1A26" Stroke="#6244DFF5" StrokeThickness="1" />
        <Path Data="M 44,52 L 88,52 M 42,80 L 90,80"
              Stroke="#263FE6FA" StrokeThickness=".8" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ModeText" Text="CODΞX" Foreground="#7082E9FB"
                       FontFamily="Consolas" FontSize="7.5"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="PercentText" Foreground="#FAFEFF"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,-1" />
            <TextBlock x:Name="LabelText" Foreground="#A9CDE0E8"
                       FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</skins:AnimatedQuotaSkin>
