<Window x:Class="CodexQuotaHud.App.UI.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Codex Quota HUD"
        Width="390"
        Height="292"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="/CodexQuotaHud.App;component/Assets/AppIcon.ico"
        Background="#FFF7F9FC"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Width="54" Height="54" Margin="0,0,16,0"
                       Source="/CodexQuotaHud.App;component/Assets/AppIcon.ico" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProductNameText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#FF102331" />
                    <TextBlock x:Name="VersionValueText"
                               Margin="0,5,0,0"
                               Foreground="#FF536A78" />
                </StackPanel>
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,18,0,14" />

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="AuthorText" Margin="0,0,0,9" />
                <TextBlock Margin="0,0,0,9">
                    <Run Text="GitHub：" />
                    <Hyperlink x:Name="RepositoryLink"
                               RequestNavigate="OnRepositoryRequestNavigate">
                        <Run x:Name="RepositoryLabelText" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="LicenseText" />
            </StackPanel>

            <Button Grid.Row="3"
                    Width="88"
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Content="关闭"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
