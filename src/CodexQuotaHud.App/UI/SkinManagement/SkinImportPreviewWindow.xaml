<Window x:Class="CodexQuotaHud.App.UI.SkinManagement.SkinImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入皮肤"
        Width="520"
        MinWidth="460"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF0C1422"
        Foreground="#FFF4F8FF"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Width="156"
                    Height="156"
                    Padding="12"
                    CornerRadius="24"
                    BorderBrush="#3353DCF8"
                    BorderThickness="1"
                    Background="#9910192A">
                <ContentControl x:Name="PreviewHost"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock x:Name="DisplayNameText"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="AuthorLabel"
                           Margin="0,8,0,0"
                           Foreground="#FFB6C5D8" />
                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           Foreground="#FFB6C5D8" />
                <TextBlock x:Name="TemplateText"
                           Margin="0,4,0,0"
                           Foreground="#FFB6C5D8" />
                <TextBlock x:Name="AssetSummaryText"
                           Margin="0,4,0,0"
                           Foreground="#FFB6C5D8" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,12,0,0"
                           Foreground="#FFE2EAF4" />
                <TextBlock x:Name="CompatibilityText"
                           Margin="0,12,0,0"
                           Foreground="#FF78E6B6" />
                <TextBlock x:Name="DowngradeReason"
                           Margin="0,8,0,0"
                           Foreground="#FFFFB547"
                           Visibility="Collapsed"
                           Text="已安装版本较新，不能降级安装。" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,24,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="InstallButton"
                        Content="安装"
                        Click="OnInstallClick" />
                <Button x:Name="ReplaceButton"
                        Content="替换"
                        Visibility="Collapsed"
                        Click="OnReplaceClick" />
                <Button x:Name="KeepCopyButton"
                        Content="保留副本"
                        Visibility="Collapsed"
                        Click="OnKeepCopyClick" />
                <Button x:Name="CancelButton"
                        Content="取消"
                        IsCancel="True"
                        Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
