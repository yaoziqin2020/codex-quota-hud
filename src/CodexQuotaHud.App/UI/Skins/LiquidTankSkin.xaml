<skins:AnimatedQuotaSkin x:Class="CodexQuotaHud.App.UI.Skins.LiquidTankSkin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexQuotaHud.App.UI.Controls"
        xmlns:skins="clr-namespace:CodexQuotaHud.App.UI.Skins"
        Width="132" Height="132" Background="Transparent">
    <Grid>
        <!-- A restrained ambient halo keeps the glass readable without making
             the skin look like another circular HUD dial. -->
        <Ellipse Width="116" Height="116" Opacity=".34">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3539DDEE" Offset="0" />
                    <GradientStop Color="#101C92C1" Offset=".66" />
                    <GradientStop Color="#001C92C1" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="11" />
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="TankAmbientTransform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Weekly quota stays peripheral and visually subordinate to the
             primary liquid level. -->
        <controls:ProgressArc x:Name="SecondaryArc"
                              Margin="4"
                              Stroke="#928A79FF"
                              TrackStroke="#18385A70"
                              StrokeThickness="2.5" />
        <StackPanel x:Name="WeeklyTicks"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,7,0"
                    Opacity=".56">
            <Border Width="7" Height="1" Margin="0,3" Background="#8FA997FF" />
            <Border Width="4" Height="1" Margin="0,3" Background="#6684DCE9" />
            <Border Width="6" Height="1" Margin="0,3" Background="#7BA997FF" />
            <Border Width="4" Height="1" Margin="0,3" Background="#6684DCE9" />
            <Border Width="7" Height="1" Margin="0,3" Background="#8FA997FF" />
        </StackPanel>

        <!-- The primary quota is a literal glass vessel whose fill height is
             driven directly from the remaining percentage. -->
        <Grid Width="82" Height="108"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border CornerRadius="38"
                    Background="#76132131"
                    BorderThickness="1.4">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D0EAFBFF" Offset="0" />
                        <GradientStop Color="#674FCFE3" Offset=".42" />
                        <GradientStop Color="#A58F77FF" Offset=".78" />
                        <GradientStop Color="#8AEAFBFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#2CCFE9" BlurRadius="12"
                                      ShadowDepth="0" Opacity=".38" />
                </Border.Effect>
            </Border>

            <Grid Width="72" Height="96"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,72,96"
                                       RadiusX="33" RadiusY="33" />
                </Grid.Clip>

                <Rectangle Fill="#25152535" />
                <Grid x:Name="LiquidLayer"
                      Height="48"
                      VerticalAlignment="Bottom"
                      ClipToBounds="True">
                    <Grid x:Name="TankSurfaceGroup"
                          Width="104"
                          Height="112"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          RenderTransformOrigin=".5,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="TankSurfaceRotateTransform" />
                                <TranslateTransform x:Name="TankSurfaceTranslateTransform" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Path x:Name="LiquidSurface"
                              Data="M 0,4 C 7,4 10,0 18,0 C 26,0 29,8 38,8 C 47,8 50,0 59,0 C 68,0 71,8 80,8 C 89,8 93,0 104,2 L 104,112 L 0,112 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E556E6F3" Offset="0" />
                                    <GradientStop Color="#D536B7EA" Offset=".36" />
                                    <GradientStop Color="#CD596DFF" Offset=".76" />
                                    <GradientStop Color="#D52E4EC3" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path x:Name="LiquidSurfaceHighlight"
                              Data="M 0,4 C 7,4 10,0 18,0 C 26,0 29,8 38,8 C 47,8 50,0 59,0 C 68,0 71,8 80,8 C 89,8 93,0 104,2"
                              Stroke="#E8F4FFFF"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Effect>
                                <DropShadowEffect Color="#B2F7FF"
                                                  BlurRadius="4"
                                                  ShadowDepth="0" />
                            </Path.Effect>
                        </Path>
                        <Path Data="M 0,7 C 9,6 12,3 20,3 C 29,3 31,11 40,11 C 49,11 52,3 61,3 C 70,3 73,11 82,11 C 91,11 95,4 104,5"
                              Stroke="#52FFFFFF"
                              StrokeThickness="4"
                              Opacity=".48" />
                    </Grid>
                    <Ellipse x:Name="BubbleOne"
                             Width="5" Height="5"
                             Fill="#83F2FFFF"
                             Opacity="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,13,9">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="BubbleOneTransform" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="BubbleTwo"
                             Width="3.5" Height="3.5"
                             Fill="#A8FFFFFF"
                             Opacity="0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="17,0,0,5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="BubbleTwoTransform" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="BubbleThree"
                             Width="7" Height="7"
                             Stroke="#6FFFFFFF"
                             StrokeThickness="1"
                             Opacity="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,27,7">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="BubbleThreeTransform" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <Path Data="M 18,13 C 9,27 9,61 18,77"
                      Stroke="#72FFFFFF"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <Ellipse Width="13" Height="6"
                         Fill="#45FFFFFF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,12,13,0"
                         RenderTransformOrigin=".5,.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-24" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <Border Margin="4"
                    CornerRadius="34"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Background="Transparent" />
        </Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock x:Name="PercentText"
                       Foreground="#FFFFFFFF"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="23"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#07141F"
                                      BlurRadius="6"
                                      ShadowDepth="1"
                                      Opacity=".92" />
                </TextBlock.Effect>
            </TextBlock>
            <Border Background="#A20A1B2A"
                    BorderBrush="#2FFFFFFF"
                    BorderThickness=".6"
                    CornerRadius="8"
                    Padding="6,1"
                    Margin="0,1,0,0">
                <TextBlock x:Name="LabelText"
                           Foreground="#EAFBFFFF"
                           FontSize="10.5"
                           FontWeight="Medium"
                           HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</skins:AnimatedQuotaSkin>
