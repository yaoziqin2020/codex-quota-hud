<Window x:Class="CodexQuotaHud.App.UI.QuotaOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CodexQuotaHud.Core.Models;assembly=CodexQuotaHud.Core"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="132"
        Height="132"
        ShowActivated="False"
        Loaded="OnWindowLoaded"
        MouseEnter="OnOrbMouseEnter"
        MouseLeave="OnOrbMouseLeave">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid x:Name="OrbRoot" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu x:Name="OrbContextMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Opened="OnContextMenuOpened"
                         Closed="OnContextMenuClosed">
                <MenuItem Header="立即刷新" Command="{Binding RefreshCommand}" />
                <MenuItem Header="皮肤">
                    <MenuItem x:Name="HudDialMenuItem" Header="HUD 科技仪表"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.HudDial}" />
                    <MenuItem x:Name="EnergyRingMenuItem" Header="双彩能量环"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.EnergyRing}" />
                    <MenuItem x:Name="LiquidGlassMenuItem" Header="流体玻璃球"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.LiquidGlass}" />
                    <MenuItem x:Name="AuroraMenuItem" Header="克制极光"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.Aurora}" />
                    <MenuItem x:Name="LiquidTankMenuItem" Header="液位储能舱"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.LiquidTank}" />
                </MenuItem>
                <MenuItem Header="动画" IsCheckable="True"
                          IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="{Binding StatusText}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <ContentControl x:Name="SkinHost" IsHitTestVisible="False" />

        <Border Background="Transparent" Cursor="SizeAll"
                MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown" />

        <Border x:Name="EdgeHandle"
                Width="6" Height="44"
                CornerRadius="3"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#53DCF8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect x:Name="EdgeHandleGlow"
                                  BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.9"
                                  Color="#24CFF2" />
            </Border.Effect>
        </Border>

        <Popup x:Name="DetailsPopup"
               PlacementTarget="{Binding ElementName=OrbRoot}"
               Placement="Custom"
               AllowsTransparency="True" StaysOpen="True">
            <Grid x:Name="PopupChrome" Margin="14">
                <Border x:Name="PopupShadowHost" Width="250" CornerRadius="12"
                        Background="#F21A202B">
                    <Border.Effect>
                    <DropShadowEffect x:Name="PopupShadow" BlurRadius="22"
                                      ShadowDepth="0" Opacity="0.55"
                                      Color="#24CFF2" />
                    </Border.Effect>
                </Border>
                <Border x:Name="PopupCard" Width="250" Padding="14"
                        CornerRadius="12" ClipToBounds="True"
                        SizeChanged="OnPopupCardSizeChanged"
                        Background="#F21A202B" BorderBrush="#6638D9FF"
                        BorderThickness="1"
                        MouseEnter="OnPopupMouseEnter"
                        MouseLeave="OnPopupMouseLeave">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,250,1000"
                                           RadiusX="12" RadiusY="12" />
                    </Border.Clip>
                    <Grid>
                        <Canvas x:Name="HudDialPopupDecoration" Opacity="0.16"
                                IsHitTestVisible="False">
                            <Line X1="18" Y1="18" X2="18" Y2="48" Stroke="#53DCF8" StrokeThickness="1" />
                            <Line X1="18" Y1="18" X2="48" Y2="18" Stroke="#53DCF8" StrokeThickness="1" />
                            <Line X1="202" Y1="18" X2="232" Y2="18" Stroke="#53DCF8" StrokeThickness="1" />
                            <Line X1="232" Y1="18" X2="232" Y2="48" Stroke="#53DCF8" StrokeThickness="1" />
                            <Rectangle Width="250" Height="1" Canvas.Top="92" Fill="#53DCF8" />
                        </Canvas>
                        <Canvas x:Name="EnergyRingPopupDecoration" Opacity="0.18"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse Width="118" Height="118" Canvas.Left="146" Canvas.Top="-34"
                                     Stroke="#53ECFF" StrokeThickness="2" />
                            <Ellipse Width="82" Height="82" Canvas.Left="164" Canvas.Top="-16"
                                     Stroke="#53ECFF" StrokeThickness="1" StrokeDashArray="3 5" />
                            <Ellipse Width="8" Height="8" Canvas.Left="160" Canvas.Top="18" Fill="#53ECFF" />
                            <Ellipse Width="6" Height="6" Canvas.Left="224" Canvas.Top="72" Fill="#53ECFF" />
                        </Canvas>
                        <Canvas x:Name="LiquidGlassPopupDecoration" Opacity="0.2"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse Width="150" Height="58" Canvas.Left="70" Canvas.Top="-22"
                                     Stroke="#D6F7FF" StrokeThickness="3" />
                            <Ellipse Width="16" Height="16" Canvas.Left="202" Canvas.Top="52"
                                     Stroke="#B9F1FF" StrokeThickness="2" />
                            <Ellipse Width="9" Height="9" Canvas.Left="180" Canvas.Top="76"
                                     Stroke="#B9F1FF" StrokeThickness="1" />
                            <Ellipse Width="5" Height="5" Canvas.Left="216" Canvas.Top="96"
                                     Fill="#B9F1FF" />
                        </Canvas>
                        <Grid x:Name="AuroraPopupDecoration" Opacity="0.2"
                              Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Height="54" VerticalAlignment="Top" Margin="-20,12,-20,0"
                                    CornerRadius="28" Background="#9B7CFF">
                                <Border.Effect><BlurEffect Radius="24" /></Border.Effect>
                            </Border>
                            <Border Height="42" VerticalAlignment="Bottom" Margin="40,0,-40,8"
                                    CornerRadius="22" Background="#79F3E2">
                                <Border.Effect><BlurEffect Radius="20" /></Border.Effect>
                            </Border>
                        </Grid>
                        <Canvas x:Name="LiquidTankPopupDecoration" Opacity="0.24"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Path Fill="#2DAED0"
                                  Data="M 0,150 C 35,132 68,164 104,146 C 142,126 178,160 214,142 C 232,134 244,136 250,140 L 250,220 L 0,220 Z" />
                            <Path Stroke="#D9FAFF" StrokeThickness="2"
                                  Data="M 12,18 C 70,3 145,30 232,10" />
                            <Ellipse Width="10" Height="10" Canvas.Left="202" Canvas.Top="112"
                                     Stroke="#D9FAFF" StrokeThickness="1" />
                            <Ellipse Width="6" Height="6" Canvas.Left="222" Canvas.Top="92"
                                     Stroke="#D9FAFF" StrokeThickness="1" />
                        </Canvas>
                        <StackPanel>
                    <Border x:Name="PopupAccent" Height="2" CornerRadius="1"
                            Margin="0,0,0,9" Background="#53DCF8" />
                    <TextBlock x:Name="PopupTitle" Text="Codex 剩余额度"
                               Foreground="White"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="#DCE8F7" />
                                        <TextBlock Text="{Binding ResetsAt, StringFormat=重置：{0}}"
                                                   Foreground="{DynamicResource PopupSecondaryTextBrush}"
                                                   FontSize="10" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Remaining}"
                                               Foreground="{DynamicResource PopupAccentBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StaleMessage}" Foreground="#FFC46B"
                               FontSize="11" Margin="0,7,0,0"
                               Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding LastUpdatedText, StringFormat=最近更新：{0}}"
                               Foreground="{DynamicResource PopupSecondaryTextBrush}"
                               FontSize="10" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
