<Window x:Class="CodexQuotaHud.App.UI.QuotaOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CodexQuotaHud.Core.Models;assembly=CodexQuotaHud.Core"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="132"
        Height="132"
        ShowActivated="False"
        MouseEnter="OnOrbMouseEnter"
        MouseLeave="OnOrbMouseLeave">
    <Grid x:Name="OrbRoot" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu x:Name="OrbContextMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Opened="OnContextMenuOpened">
                <MenuItem Header="立即刷新" Command="{Binding RefreshCommand}" />
                <MenuItem Header="皮肤">
                    <MenuItem x:Name="HudDialMenuItem" Header="HUD 科技仪表"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.HudDial}" />
                    <MenuItem x:Name="EnergyRingMenuItem" Header="双彩能量环"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.EnergyRing}" />
                    <MenuItem x:Name="LiquidGlassMenuItem" Header="流体玻璃球"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.LiquidGlass}" />
                    <MenuItem x:Name="AuroraMenuItem" Header="克制极光"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.Aurora}" />
                    <MenuItem x:Name="LiquidTankMenuItem" Header="液位储能舱"
                              IsCheckable="True" Command="{Binding SelectSkinCommand}"
                              CommandParameter="{x:Static models:SkinId.LiquidTank}" />
                </MenuItem>
                <MenuItem Header="动画" IsCheckable="True"
                          IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="{Binding StatusText}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <ContentControl x:Name="SkinHost" IsHitTestVisible="False" />

        <Border Background="Transparent" Cursor="SizeAll"
                MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown" />

        <Popup x:Name="DetailsPopup"
               PlacementTarget="{Binding ElementName=OrbRoot}"
               Placement="Right" HorizontalOffset="8"
               AllowsTransparency="True" StaysOpen="True">
            <Border Width="250" Padding="14" CornerRadius="12"
                    Background="#F21A202B" BorderBrush="#6638D9FF" BorderThickness="1"
                    MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
                <StackPanel>
                    <TextBlock Text="Codex 剩余额度" Foreground="White"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="#DCE8F7" />
                                        <TextBlock Text="{Binding ResetsAt, StringFormat=重置：{0}}"
                                                   Foreground="#8393A8" FontSize="10" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Remaining}"
                                               Foreground="#53DCF8" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StaleMessage}" Foreground="#FFC46B"
                               FontSize="11" Margin="0,7,0,0"
                               Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding LastUpdatedText, StringFormat=最近更新：{0}}"
                               Foreground="#8393A8" FontSize="10" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
