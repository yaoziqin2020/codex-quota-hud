<skins:AnimatedQuotaSkin x:Class="CodexQuotaHud.App.UI.Skins.LiquidTankSkin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexQuotaHud.App.UI.Controls"
        xmlns:skins="clr-namespace:CodexQuotaHud.App.UI.Skins"
        Width="132" Height="132" Background="Transparent">
    <Grid Margin="4">
        <Ellipse Margin="4" Fill="#E308111A" Stroke="#6A31D6E8" StrokeThickness="1.2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#21CFE8" BlurRadius="13" ShadowDepth="0" Opacity=".32" />
            </Ellipse.Effect>
        </Ellipse>
        <controls:ProgressArc x:Name="SecondaryArc" Margin="7"
                              Stroke="#AE836AFF" TrackStroke="#243F3468"
                              StrokeThickness="4" />
        <Grid Width="76" Height="90" VerticalAlignment="Center">
            <Border CornerRadius="31" BorderBrush="#B65EE8F2" BorderThickness="2"
                    Background="#71101F2A" />
            <Grid Margin="5" ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,66,80" RadiusX="27" RadiusY="27" />
                </Grid.Clip>
                <Rectangle x:Name="LiquidFill" Height="40"
                           VerticalAlignment="Bottom" RenderTransformOrigin=".5,.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC48E8F5" Offset="0" />
                            <GradientStop Color="#B93C8BFF" Offset=".58" />
                            <GradientStop Color="#AA6552E9" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="TankSloshTransform" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Path x:Name="WaveCrest" Data="M -4,43 C 10,36 21,49 34,42 C 48,35 60,48 72,40"
                      Stroke="#C4E8FCFF" StrokeThickness="1.5"
                      RenderTransformOrigin=".5,.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="TankWaveTransform" />
                    </Path.RenderTransform>
                </Path>
                <Ellipse Width="6" Height="6" Fill="#80FFFFFF"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,12,19" />
            </Grid>
            <Border CornerRadius="31" BorderBrush="#35FFFFFF" BorderThickness="1"
                    Margin="4" />
        </Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText" Foreground="#FFFFFF"
                       FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#09213A" BlurRadius="4" ShadowDepth="1" />
                </TextBlock.Effect>
            </TextBlock>
            <Border Background="#8A102437" CornerRadius="7" Padding="5,1">
                <TextBlock x:Name="LabelText" Foreground="#E2F8FD"
                           FontSize="10" HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
        <Border Width="28" Height="5" CornerRadius="2.5"
                Background="#7D64E8F3" VerticalAlignment="Top" Margin="0,8,0,0" />
        <Border Width="20" Height="4" CornerRadius="2"
                Background="#603E8EA2" VerticalAlignment="Bottom" Margin="0,0,0,7" />
    </Grid>
</skins:AnimatedQuotaSkin>
