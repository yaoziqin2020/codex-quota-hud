<skins:AnimatedQuotaSkin x:Class="CodexQuotaHud.App.UI.Skins.LiquidGlassSkin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexQuotaHud.App.UI.Controls"
        xmlns:skins="clr-namespace:CodexQuotaHud.App.UI.Skins"
        Width="132" Height="132" Background="Transparent">
    <Grid Margin="4">
        <Ellipse Margin="7" Stroke="#6E8BE7FF" StrokeThickness="1.2">
            <Ellipse.Fill>
                <RadialGradientBrush Center=".34,.25" GradientOrigin=".28,.18"
                                     RadiusX=".72" RadiusY=".72">
                    <GradientStop Color="#B75E91A9" Offset="0" />
                    <GradientStop Color="#C5244059" Offset=".42" />
                    <GradientStop Color="#E20A1727" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#58CFFF" BlurRadius="15" ShadowDepth="0" Opacity=".35" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="13" ClipToBounds="True">
            <Grid.Clip>
                <EllipseGeometry Center="53,53" RadiusX="53" RadiusY="53" />
            </Grid.Clip>
            <Canvas RenderTransformOrigin=".5,.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="GlassFluidTransform" />
                </Canvas.RenderTransform>
                <Ellipse x:Name="FluidBlob" Width="82" Height="55"
                         Canvas.Left="-2" Canvas.Top="54" Opacity=".62">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#9A48E6FF" Offset="0" />
                            <GradientStop Color="#785D6DFF" Offset=".58" />
                            <GradientStop Color="#4062F0DA" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="70" Height="44" Canvas.Left="45" Canvas.Top="62"
                         Fill="#4F8A68FF" />
                <Ellipse Width="8" Height="8" Canvas.Left="75" Canvas.Top="35"
                         Fill="#95DFFBFF" />
                <Ellipse Width="4" Height="4" Canvas.Left="88" Canvas.Top="51"
                         Fill="#AEFFFFFF" />
            </Canvas>
        </Grid>

        <Ellipse Margin="18,16,55,56" Fill="#24FFFFFF" />
        <Path Data="M 36,26 C 25,35 20,48 21,60"
              Stroke="#A5FFFFFF" StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <controls:ProgressArc x:Name="SecondaryArc" Margin="3"
                              Stroke="#9F8B75FF" TrackStroke="#245C80A0"
                              StrokeThickness="3" />
        <controls:ProgressArc x:Name="PrimaryArc" Margin="14"
                              Stroke="#DDE9FBFF" TrackStroke="#286CC9E5"
                              StrokeThickness="4.5" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText" Foreground="White"
                       FontSize="23" FontWeight="SemiBold"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#0B2234" BlurRadius="5" ShadowDepth="1" />
                </TextBlock.Effect>
            </TextBlock>
            <Border Background="#52213A4D" CornerRadius="7" Padding="5,1">
                <TextBlock x:Name="LabelText" Foreground="#ECF8FF"
                           FontSize="10.5" HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</skins:AnimatedQuotaSkin>
