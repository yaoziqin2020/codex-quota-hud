<skins:AnimatedQuotaSkin x:Class="CodexQuotaHud.App.UI.Skins.LiquidTankSkin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexQuotaHud.App.UI.Controls"
        xmlns:skins="clr-namespace:CodexQuotaHud.App.UI.Skins"
        Width="132" Height="132" Background="Transparent">
    <Grid>
        <!-- A restrained ambient halo keeps the glass readable without making
             the skin look like another circular HUD dial. -->
        <Ellipse Width="116" Height="116" Opacity=".34">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3539DDEE" Offset="0" />
                    <GradientStop Color="#101C92C1" Offset=".66" />
                    <GradientStop Color="#001C92C1" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="11" />
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="TankAmbientTransform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Weekly quota stays peripheral and visually subordinate to the
             primary liquid level. -->
        <controls:ProgressArc x:Name="SecondaryArc"
                              Margin="4"
                              Stroke="#928A79FF"
                              TrackStroke="#18385A70"
                              StrokeThickness="2.5" />
        <StackPanel x:Name="WeeklyTicks"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,7,0"
                    Opacity=".56">
            <Border Width="7" Height="1" Margin="0,3" Background="#8FA997FF" />
            <Border Width="4" Height="1" Margin="0,3" Background="#6684DCE9" />
            <Border Width="6" Height="1" Margin="0,3" Background="#7BA997FF" />
            <Border Width="4" Height="1" Margin="0,3" Background="#6684DCE9" />
            <Border Width="7" Height="1" Margin="0,3" Background="#8FA997FF" />
        </StackPanel>

        <!-- The primary quota is a literal glass vessel whose fill height is
             driven directly from the remaining percentage. -->
        <Grid Width="82" Height="108"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border CornerRadius="38"
                    Background="#76132131"
                    BorderThickness="1.4">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D0EAFBFF" Offset="0" />
                        <GradientStop Color="#674FCFE3" Offset=".42" />
                        <GradientStop Color="#A58F77FF" Offset=".78" />
                        <GradientStop Color="#8AEAFBFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#2CCFE9" BlurRadius="12"
                                      ShadowDepth="0" Opacity=".38" />
                </Border.Effect>
            </Border>

            <Grid x:Name="VesselViewport"
                  Width="72" Height="96"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,72,96"
                                       RadiusX="33" RadiusY="33" />
                </Grid.Clip>

                <Rectangle Fill="#25152535" />
                <!-- The vessel owns the only water clip. The wave center is
                     positioned at the actual quota waterline, so a high
                     quota never clips its crest against a fill-height box. -->
                <Canvas x:Name="LiquidLayer"
                        Width="72"
                        Height="96">
                    <Grid x:Name="TankSurfaceGroup"
                          Width="144"
                          Height="100"
                          Canvas.Left="0"
                          Canvas.Top="44">
                        <!-- The body owns the quota height and never moves.
                             Both wave caps overlap it, so their horizontal
                             drift cannot expose a seam. -->
                        <Rectangle x:Name="LiquidBody"
                                   Margin="0,4,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#DB45CDEB" Offset="0" />
                                    <GradientStop Color="#D536B7EA" Offset=".28" />
                                    <GradientStop Color="#CD596DFF" Offset=".76" />
                                    <GradientStop Color="#D52E4EC3" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Grid Width="144" Height="100"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Opacity=".52">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="BackWaveTransform" />
                            </Grid.RenderTransform>
                            <Path x:Name="BackWaveSurface"
                                  Data="M 0,4 C 4,0 8,0 12,4 C 16,8 20,8 24,4 C 28,0 32,0 36,4 C 40,8 44,8 48,4 C 52,0 56,0 60,4 C 64,8 68,8 72,4 C 76,0 80,0 84,4 C 88,8 92,8 96,4 C 100,0 104,0 108,4 C 112,8 116,8 120,4 C 124,0 128,0 132,4 C 136,8 140,8 144,4 L 144,100 L 0,100 Z"
                                  Fill="#BD72DDF2" />
                        </Grid>

                        <Grid Width="144" Height="100"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Opacity=".9">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="FrontWaveTransform" />
                            </Grid.RenderTransform>
                            <Path x:Name="FrontWaveSurface"
                                  Data="M 0,4 C 4,8 8,8 12,4 C 16,0 20,0 24,4 C 28,8 32,8 36,4 C 40,0 44,0 48,4 C 52,8 56,8 60,4 C 64,0 68,0 72,4 C 76,8 80,8 84,4 C 88,0 92,0 96,4 C 100,8 104,8 108,4 C 112,0 116,0 120,4 C 124,8 128,8 132,4 C 136,0 140,0 144,4 L 144,100 L 0,100 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EAF2FDFF" Offset="0" />
                                        <GradientStop Color="#DD50D2EE" Offset=".24" />
                                        <GradientStop Color="#D536B7EA" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M 0,4 C 4,8 8,8 12,4 C 16,0 20,0 24,4 C 28,8 32,8 36,4 C 40,0 44,0 48,4 C 52,8 56,8 60,4 C 64,0 68,0 72,4 C 76,8 80,8 84,4 C 88,0 92,0 96,4 C 100,8 104,8 108,4 C 112,0 116,0 120,4 C 124,8 128,8 132,4 C 136,0 140,0 144,4"
                                  Stroke="#CFF6FFFF"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>

                        <Grid Margin="0,4,0,0"
                              ClipToBounds="True">
                            <Ellipse x:Name="BubbleOne"
                                     Width="5" Height="5"
                                     Fill="#83F2FFFF"
                                     Opacity="0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="46,0,0,9">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="BubbleOneTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="BubbleTwo"
                                     Width="3.5" Height="3.5"
                                     Fill="#A8FFFFFF"
                                     Opacity="0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="17,0,0,5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="BubbleTwoTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                </Canvas>

                <Path Data="M 18,13 C 9,27 9,61 18,77"
                      Stroke="#72FFFFFF"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <Ellipse Width="13" Height="6"
                         Fill="#45FFFFFF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,12,13,0"
                         RenderTransformOrigin=".5,.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-24" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <Border Margin="4"
                    CornerRadius="34"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Background="Transparent" />
        </Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock x:Name="PercentText"
                       Foreground="#FFFFFFFF"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="23"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#07141F"
                                      BlurRadius="6"
                                      ShadowDepth="1"
                                      Opacity=".92" />
                </TextBlock.Effect>
            </TextBlock>
            <Border Background="#A20A1B2A"
                    BorderBrush="#2FFFFFFF"
                    BorderThickness=".6"
                    CornerRadius="8"
                    Padding="6,1"
                    Margin="0,1,0,0">
                <TextBlock x:Name="LabelText"
                           Foreground="#EAFBFFFF"
                           FontSize="10.5"
                           FontWeight="Medium"
                           HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</skins:AnimatedQuotaSkin>
